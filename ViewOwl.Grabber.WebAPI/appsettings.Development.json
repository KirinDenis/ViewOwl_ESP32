{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DeviceMonitor": {
    "CheckIntervalSeconds": 10,
    "OfflineThresholdSeconds": 60
  },
  "Shared": {
    // Local dev server runs on 5085 (see Properties/launchSettings.json).
    // Production uses 5000. This override prevents Chrome from hitting ERR_CONNECTION_REFUSED
    // when loading SiteTemplate pages via WebApiBaseUrl.
    "WebApiBaseUrl": "http://localhost:5085"
  }
}
