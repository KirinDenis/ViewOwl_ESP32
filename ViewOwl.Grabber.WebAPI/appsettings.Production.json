{
  // Production settings for a Linux server deployment.
  // This file overrides appsettings.Shared.json on the server.
  // The deploy workflow copies this file over appsettings.Shared.json
  // in both the Grabber and UDP Server output directories.

  // Bind to loopback only — Caddy handles public TLS on 443/80.
  // Declared here (not only in the systemd unit) so the URL is always
  // applied regardless of whether the environment variable is visible.
  "Urls": "http://127.0.0.1:5000",

  "Shared": {
    "ExchangeFolder": "/opt/viewowl/exchange/",
    "WebApiBaseUrl": "http://localhost:5000",
    "AutoCreateDeviceStatusTemplate": true
  }
}
